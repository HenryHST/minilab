# Optional env vars for homepage (Secret `homepage` via Ansible SecretSpec).
# Do not commit real values.
#
# OPENWEATHERMAP_API_KEY=CHANGE_ME
#
# HOMEPAGE_VAR_ARGOCD_KEY=          # secretspec HOMEPAGE_ARGOCD_API_KEY
# HOMEPAGE_VAR_UNIFI_URL=https://192.168.0.1
# HOMEPAGE_VAR_UNIFI_USER=          # secretspec UNIFI_USER
# HOMEPAGE_VAR_UNIFI_PASS=          # secretspec UNIFI_PASS
# HOMEPAGE_VAR_PROXMOX_USER=        # e.g. homepage@pam!homepage
# HOMEPAGE_VAR_PROXMOX_TOKEN=       # secretspec HOMEPAGE_PROXMOX_TOKEN
