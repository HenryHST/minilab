# secret.yml.example — Hetzner DNS token for cert-manager webhook (DNS-01).
# Production: applied by Ansible SecretSpec (`ansible-playbook site.yaml --tags secrets`),
# not from git. Copy to secret.yml only for manual/local testing.
apiVersion: v1
kind: Secret
metadata:
  name: hetzner
  namespace: certmanager
stringData:
  token: CHANGE_ME_HETZNER_DNS_TOKEN
