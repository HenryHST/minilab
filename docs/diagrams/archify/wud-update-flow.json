    { "id": "kapi", "type": "backend", "label": "Kubernetes API", "sublabel": "read-only" },
    { "id": "reg", "type": "database", "label": "Registries", "sublabel": "intern + public" },
    { "id": "push", "type": "external", "label": "Pushover", "sublabel": "Trigger NXK3" },
    { "id": "mqtt", "type": "messagebus", "label": "Mosquitto", "sublabel": "wud/container" },
    { "id": "ha", "type": "external", "label": "Home Assistant", "sublabel": "MQTT Discovery" }
  ],
  "segments": [
    { "from": 150, "to": 260, "label": "Workloads finden" },
    { "from": 270, "to": 370, "label": "Tags vergleichen" },
    { "from": 380, "to": 500, "label": "Melden" }
  ],
  "messages": [
