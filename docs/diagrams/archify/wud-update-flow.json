  "cards": [
    {
      "dot": "cyan",
      "title": "Finden",
      "items": [
        "ServiceAccount wud liest nur (get/list)",
        "Annotation getwud.app/watch=false schließt aus"
      ]
    },
    {
      "dot": "orange",
      "title": "Vergleichen",
      "items": [
        "Interne Images über registry.stadthagen.dev (User registry)",
        "getwud.app/tag.include filtert z. B. nur Semver"
      ]
    },
    {
      "dot": "emerald",
      "title": "Melden",
      "items": [
        "Pushover: eine Nachricht pro neuem Tag (ONCE=true)",
