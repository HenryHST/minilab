    { "id": "tags", "from": "wud", "to": "reg", "y": 285, "label": "GET /v2/<image>/tags/list", "variant": "default" },
    { "id": "tagsback", "from": "reg", "to": "wud", "y": 315, "label": "Tags, Digest", "variant": "return", "note": "WUD vergleicht semver + tag.include" },
    { "id": "notify", "from": "wud", "to": "push", "y": 400, "label": "Neue Version (einmal pro Update)", "variant": "emphasis" },
    { "id": "publish", "from": "wud", "to": "mqtt", "y": 435, "label": "publish wud/container/<id>", "variant": "default" },
    { "id": "discovery", "from": "mqtt", "to": "ha", "y": 470, "label": "update.* Entity", "variant": "dashed" }
  ],
  "activations": [
    { "participant": "wud", "from": 165, "to": 480, "type": "backend" },
    { "participant": "kapi", "from": 190, "to": 230, "type": "backend" },
    { "participant": "reg", "from": 280, "to": 320, "type": "database" },
    { "participant": "mqtt", "from": 430, "to": 476, "type": "messagebus" }
